# Frontend-first mode: Groq, Twilio, Telegram, WhatsApp & SMS keys can all be entered
# directly in the web Settings & Message Alerts tabs without editing .env files.
# Only NGROK_AUTH_TOKEN is required in Kaggle Secrets to expose the GPU backend URL.
NGROK_AUTH_TOKEN=
TWILIO_VOICE_ENGINE=f5tts
TTS_ENGINE=f5tts

